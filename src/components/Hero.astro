<section class="w-full h-[520px] py-24 px-16 border-b-4 border-border bg-green" aria-label="Hero section">
  <div class="grid grid-cols-3 gap-2">
    <div class="col-span-2">
      <p id="typing-text" class="text-lg text-black -tracking-tight font-semibold inline-block min-h-[28px] hero-element" aria-live="polite" aria-atomic="true"
        ></p
      >
      <h1 class="text-6xl font-bold text-black hero-element">
        Creating high-performance, scalable web applications
      </h1>
      <p class="text-lg text-black/80 mt-2 hero-element">
        2+ years building web applications with modern technologies, clean
        architecture and exceptional user experiences, powered by AI.
      </p>
      <a
        href="#projects"
        class="hero-element inline-block font-global font-medium uppercase -tracking-tight text-sm sm:text-lg px-3 py-1.5 sm:px-4 sm:py-2 bg-black text-white border-[3px] border-black cursor-pointer shadow-[8px_8px_0px_0px_rgba(0,0,0,1)] transition-all duration-200 hover:-translate-y-1 hover:shadow-[12px_12px_0px_0px_rgba(0,0,0,1)] active:translate-x-0 active:translate-y-0 active:shadow-none mt-4"
        aria-label="View my projects"
      >
        Check my work
      </a>
    </div>
  </div>
</section>

<script>
  import { animate, stagger } from 'animejs';

  // Animaciones de entrada
  document.addEventListener('DOMContentLoaded', () => {
    const heroElements = document.querySelectorAll('.hero-element');
    const heroImage = document.querySelector('.hero-image');

    // Animar elementos del hero con stagger
    animate(heroElements, {
      translateY: [40, 0],
      opacity: [0, 1],
      duration: 800,
      delay: stagger(150),
      easing: 'out-cubic'
    });

    // Animar imagen con efecto de escala
    if (heroImage) {
      animate(heroImage, {
        scale: [0.8, 1],
        opacity: [0, 1],
        duration: 1000,
        delay: 400,
        easing: 'out-back'
      });
    }
  });

  const texts = [
    "Web Developer",
    "2+ Years of Experience",
    "Clean Architecture and smooth UX"
  ];
  
  let currentIndex = 0;
  const textElement = document.getElementById("typing-text");

  function typeText() {
    const currentText = texts[currentIndex];
    let charIndex = 0;
    
    if (textElement) {
      textElement.textContent = "";
      
      const typeInterval = setInterval(() => {
        if (charIndex < currentText.length) {
          textElement.textContent += currentText[charIndex];
          charIndex++;
        } else {
          clearInterval(typeInterval);
          setTimeout(() => {
            eraseText();
          }, 2000);
        }
      }, 100);
    }
  }

  function eraseText() {
    if (textElement) {
      const currentText = textElement.textContent || "";
      let charIndex = currentText.length;
      
      const eraseInterval = setInterval(() => {
        if (charIndex > 0) {
          textElement.textContent = currentText.substring(0, charIndex - 1);
          charIndex--;
        } else {
          clearInterval(eraseInterval);
          currentIndex = (currentIndex + 1) % texts.length;
          setTimeout(() => {
            typeText();
          }, 500);
        }
      }, 50);
    }
  }

  typeText();
</script>
