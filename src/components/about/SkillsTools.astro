---
const skills = [
  {
    category: "Design",
    items: ["Figma", "v0", "UI/UX Design", "Wireframing", "Prototyping"]
  },
  {
    category: "Frontend",
    items: ["React", "Next.js", "TypeScript", "Tailwind CSS", "Astro", "Svelte"]
  },
  {
    category: "Backend",
    items: ["Node.js", "PostgreSQL", "Express.js", "NestJS", "TypeORM", "Prisma"]
  }
]
---

<section class="w-full py-8 sm:py-10 md:py-12 px-4 sm:px-6 md:px-8 lg:px-16 border-b-4 border-border bg-orange">
  <div class="container mx-auto max-w-7xl">
    <div class="flex flex-col space-y-6 sm:space-y-8 md:space-y-9">
      <h2 class="skills-title font-bold text-2xl sm:text-3xl md:text-4xl uppercase -tracking-wider text-black opacity-0">Skills & Tools</h2>
      
      <div class="grid grid-cols-1 md:grid-cols-3 gap-4 sm:gap-5 md:gap-6">
        {skills.map((skill) => (
          <div class="skill-card bg-white border-3 sm:border-4 border-black p-4 sm:p-5 md:p-6 shadow-[6px_6px_0px_0px_rgba(0,0,0,1)] sm:shadow-[8px_8px_0px_0px_rgba(0,0,0,1)] hover:shadow-[8px_8px_0px_0px_rgba(0,0,0,1)] md:hover:shadow-[12px_12px_0px_0px_rgba(0,0,0,1)] hover:-translate-y-1 transition-all duration-200 flex flex-col gap-3 sm:gap-4 opacity-0">
            <h3 class="text-lg sm:text-xl md:text-2xl font-bold text-black -tracking-tight uppercase">{skill.category}</h3>
          <ul class="flex flex-col gap-2">
            {skill.items.map((item) => (
              <li class="flex items-center gap-2 text-black text-sm sm:text-base">
                <span class="w-1.5 h-1.5 sm:w-2 sm:h-2 bg-black rounded-full shrink-0"></span>
                <span class="font-medium">{item}</span>
              </li>
            ))}
          </ul>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

<script>
  import { animate, stagger } from 'animejs';

  document.addEventListener('DOMContentLoaded', () => {
    const title = document.querySelector('.skills-title');
    const cards = document.querySelectorAll('.skill-card');

    const observer = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          if (title) {
            animate(title, {
              translateX: [-100, 0],
              opacity: [0, 1],
              duration: 800,
              easing: 'out-expo'
            });
          }

          if (cards.length > 0) {
            animate(cards, {
              translateY: [50, 0],
              opacity: [0, 1],
              duration: 800,
              delay: stagger(150),
              easing: 'out-expo'
            });
          }

          observer.disconnect();
        }
      });
    }, { threshold: 0.1 });

    if (title) {
      observer.observe(title);
    }
  });
</script>
