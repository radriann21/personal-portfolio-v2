<section class="w-full min-h-[340px] py-12 sm:py-16 md:py-20 lg:py-24 px-4 sm:px-6 md:px-8 lg:px-16 border-b-4 border-border bg-green">
  <div class="container mx-auto max-w-7xl">
    <h2 class="about-hero-title font-bold text-2xl sm:text-3xl md:text-4xl -tracking-wider mb-4 sm:mb-6 text-black">About Me</h2>
    <p class="about-hero-text text-base sm:text-lg md:text-xl w-full md:w-3/4 lg:w-1/2 text-black">
      Web developer with 2+ years of experience building scalable applications.
      I turn ideas into high-performance digital products using modern
      technologies and best practices, powered by AI.
    </p>
  </div>
</section>

<script>
  import { animate } from 'animejs';

  document.addEventListener('DOMContentLoaded', () => {
    const title = document.querySelector('.about-hero-title');
    const text = document.querySelector('.about-hero-text');

    if (title) {
      animate(title, {
        translateY: [-50, 0],
        opacity: [0, 1],
        duration: 800,
        easing: 'out-expo'
      });
    }

    if (text) {
      animate(text, {
        translateY: [-30, 0],
        opacity: [0, 1],
        duration: 800,
        delay: 200,
        easing: 'out-expo'
      });
    }
  });
</script>
