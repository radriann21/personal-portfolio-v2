---
import { getCollection } from 'astro:content';
import ProjectCard from "./ProjectCard.astro";

const projects = await getCollection('projects');
const featuredProjects = projects.filter(p => p.data.featured).slice(0, 4);
---

<section class="w-full py-8 sm:py-10 md:py-12 px-4 sm:px-6 md:px-8 lg:px-16 border-b-4 border-border bg-pink">
  <div class="container mx-auto max-w-7xl">
    <div class="flex flex-col space-y-6 sm:space-y-8 md:space-y-9">
      <div class="w-full flex items-center justify-between">
        <h3 class="font-bold text-2xl sm:text-3xl md:text-4xl uppercase -tracking-wider text-black" id="projects">
          Selected Work
        </h3>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4 sm:gap-5 md:gap-6">
        {featuredProjects.map((project) => (
          <div class="project-card-wrapper">
            <ProjectCard
              slug={project.slug}
              title={project.data.title}
              description={project.data.description}
              image={project.data.image}
              tags={project.data.tags}
              project={{
                codeUrl: project.data.codeUrl,
                liveUrl: project.data.liveUrl,
              }}
            />
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

<script>
  import { animate, stagger } from 'animejs';

  document.addEventListener('DOMContentLoaded', () => {
    const projectCards = document.querySelectorAll('.project-card-wrapper');

    // Crear observer para animar cuando entran en viewport
    const observer = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          const cards = document.querySelectorAll('.project-card-wrapper');
          animate(cards, {
            translateY: [60, 0],
            opacity: [0, 1],
            duration: 800,
            delay: stagger(150),
            easing: 'out-cubic'
          });
          observer.disconnect();
        }
      });
    }, { threshold: 0.1 });

    if (projectCards.length > 0) {
      observer.observe(projectCards[0]);
    }
  });
</script>
