---
import { menuOptions } from "../utils/menuOptions";
import MobileMenu from "./MobileMenu.astro";
---

<header id="header" class="w-full py-3 sm:py-4 lg:py-6 border-b-4 border-border" role="banner">
  <div class="flex items-center container mx-auto justify-between px-4 sm:px-6 lg:px-8 max-w-7xl">
    <div>
      <a href="/" class="font-global font-bold uppercase -tracking-tight text-base sm:text-lg md:text-xl lg:text-2xl hover:text-accent transition-colors" aria-label="Adrian Rangel - Home">
        Adrian Rangel
      </a>
    </div>
    <div class="flex items-center gap-x-2 sm:gap-x-3 md:gap-x-6 lg:gap-x-8">
      <nav class="hidden md:block" aria-label="Main navigation">
        <ul class="flex items-center gap-x-3 lg:gap-x-6 xl:gap-x-8">
          {
            menuOptions.map((option) => (
              <li>
                <a
                  href={option.href}
                  class="font-global font-medium uppercase -tracking-tight text-xs md:text-sm lg:text-base xl:text-lg hover:text-accent transition-colors duration-100"
                  aria-label={`Navigate to ${option.name}`}
                >
                  {option.name}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
      <a
        href="/cv.pdf"
        download
        class="hidden sm:inline-block font-global font-medium uppercase -tracking-tight text-xs sm:text-sm md:text-base lg:text-lg px-2.5 py-1.5 sm:px-3 sm:py-2 md:px-4 md:py-2.5 bg-pink text-white border-2 sm:border-[3px] border-black cursor-pointer shadow-[4px_4px_0px_0px_rgba(0,0,0,1)] sm:shadow-[6px_6px_0px_0px_rgba(0,0,0,1)] md:shadow-[8px_8px_0px_0px_rgba(0,0,0,1)] transition-all duration-200 hover:-translate-y-1 hover:shadow-[6px_6px_0px_0px_rgba(0,0,0,1)] md:hover:shadow-[12px_12px_0px_0px_rgba(0,0,0,1)] active:translate-x-0 active:translate-y-0 active:shadow-none whitespace-nowrap"
        aria-label="Download CV (PDF)"
      >
        Download CV
      </a>
      <MobileMenu />
    </div>
  </div>
</header>