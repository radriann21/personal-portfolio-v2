---
import { menuOptions } from "../utils/menuOptions";
---

<header id="header" class="w-full py-4 lg:py-6 border-b-4 border-border">
  <div class="flex items-center container mx-auto justify-between px-4">
    <div>
      <h1
        class="font-global font-bold uppercase -tracking-tight text-lg sm:text-2xl"
      >
        Adrian Rangel
      </h1>
    </div>
    <div class="flex items-center gap-x-4 sm:gap-x-8">
      <nav class="hidden md:block">
        <ul class="flex items-center gap-x-4 lg:gap-x-8">
          {
            menuOptions.map((option) => (
              <li>
                <a
                  href={option.href}
                  class="font-global font-medium uppercase -tracking-tight text-sm lg:text-lg hover:text-accent transition-colors duration-100"
                >
                  {option.name}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
      <button
        class="font-global font-medium uppercase -tracking-tight text-sm sm:text-lg px-3 py-1.5 sm:px-4 sm:py-2 bg-accent text-white border-[3px] border-black cursor-pointer shadow-[8px_8px_0px_0px_rgba(0,0,0,1)] transition-all duration-200 hover:-translate-y-1 hover:shadow-[12px_12px_0px_0px_rgba(0,0,0,1)] active:translate-x-0 active:translate-y-0 active:shadow-none"
      >
        Download CV
      </button>
    </div>
  </div>
</header>