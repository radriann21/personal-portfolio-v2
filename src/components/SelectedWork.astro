---
import { getCollection } from 'astro:content';
import ProjectCard from "./ProjectCard.astro";

const projects = await getCollection('projects');
const featuredProjects = projects.filter(p => p.data.featured).slice(0, 4);
---

<section class="w-full py-12 px-16 border-b-4 border-border bg-pink">
  <div class="flex flex-col space-y-9">
    <div class="w-full flex items-center justify-between">
      <h3 class="font-bold text-4xl uppercase -tracking-wider text-black" id="projects">
        Selected Work
      </h3>
    </div>
    <div class="grid grid-cols-2 gap-4">
      {featuredProjects.map((project) => (
        <ProjectCard
          slug={project.slug}
          title={project.data.title}
          description={project.data.description}
          image={project.data.image}
          tags={project.data.tags}
          project={{
            codeUrl: project.data.codeUrl,
            liveUrl: project.data.liveUrl,
          }}
        />
      ))}
    </div>
  </div>
</section>
