          class="font-global font-medium uppercase -tracking-tight text-xs sm:text-sm md:text-base lg:text-lg px-3 py-2 sm:px-4 sm:py-2.5 bg-blue text-white border-2 sm:border-[3px] border-black cursor-pointer shadow-[4px_4px_0px_0px_rgba(0,0,0,1)] sm:shadow-[6px_6px_0px_0px_rgba(0,0,0,1)] md:shadow-[8px_8px_0px_0px_rgba(0,0,0,1)] transition-all duration-200 hover:-translate-y-1 hover:shadow-[6px_6px_0px_0px_rgba(0,0,0,1)] md:hover:shadow-[12px_12px_0px_0px_rgba(0,0,0,1)] active:translate-x-0 active:translate-y-0 active:shadow-none whitespace-nowrap"
