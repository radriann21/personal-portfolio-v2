<section class="w-full min-h-[520px] py-16 md:py-20 lg:py-24 px-4 sm:px-6 md:px-8 lg:px-16 border-b-4 border-border bg-green flex items-center" aria-label="Hero section">
  <div class="container mx-auto max-w-7xl w-full">
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6 lg:gap-8">
      <div class="col-span-1 lg:col-span-2 flex flex-col justify-center">
        <p id="typing-text" class="text-sm sm:text-base md:text-lg lg:text-base text-black -tracking-tight font-semibold inline-block min-h-[24px] sm:min-h-[28px] hero-element mb-3 md:mb-4 lg:mb-3" aria-live="polite" aria-atomic="true"
          ></p
        >
        <h1 class="text-3xl sm:text-4xl md:text-5xl lg:text-5xl xl:text-6xl font-bold text-black hero-element leading-tight">
          Creating high-performance, scalable web applications
        </h1>
        <p class="text-sm sm:text-base md:text-lg lg:text-lg text-black/80 mt-4 md:mt-5 lg:mt-4 hero-element max-w-2xl leading-relaxed">
          2+ years building web applications with modern technologies, clean
          architecture and exceptional user experiences, powered by AI.
        </p>
        <div class="mt-8 md:mt-9 lg:mt-7">
          <a
            href="#projects"
            class="hero-element inline-block font-global font-medium uppercase -tracking-tight text-xs sm:text-sm md:text-base lg:text-base px-5 py-2.5 sm:px-6 sm:py-3 md:px-7 md:py-3.5 lg:px-6 lg:py-3 bg-black text-white border-[3px] border-black cursor-pointer shadow-[6px_6px_0px_0px_rgba(0,0,0,1)] md:shadow-[8px_8px_0px_0px_rgba(0,0,0,1)] transition-all duration-200 hover:-translate-y-1 hover:shadow-[8px_8px_0px_0px_rgba(0,0,0,1)] md:hover:shadow-[12px_12px_0px_0px_rgba(0,0,0,1)] active:translate-x-0 active:translate-y-0 active:shadow-none"
            aria-label="View my projects"
          >
            Check my work
          </a>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  import { animate, stagger } from 'animejs';

  // Animaciones de entrada
  document.addEventListener('DOMContentLoaded', () => {
    const heroElements = document.querySelectorAll('.hero-element');
    const heroImage = document.querySelector('.hero-image');

    // Animar elementos del hero con stagger
    animate(heroElements, {
      translateY: [40, 0],
      opacity: [0, 1],
      duration: 800,
      delay: stagger(150),
      easing: 'out-cubic'
    });

    // Animar imagen con efecto de escala
    if (heroImage) {
      animate(heroImage, {
        scale: [0.8, 1],
        opacity: [0, 1],
        duration: 1000,
        delay: 400,
        easing: 'out-back'
      });
    }
  });

  const texts = [
    "Web Developer",
    "2+ Years of Experience",
    "Clean Architecture and smooth UX"
  ];
  
  let currentIndex = 0;
  const textElement = document.getElementById("typing-text");

  function typeText() {
    const currentText = texts[currentIndex];
    let charIndex = 0;
    
    if (textElement) {
      textElement.textContent = "";
      
      const typeInterval = setInterval(() => {
        if (charIndex < currentText.length) {
          textElement.textContent += currentText[charIndex];
          charIndex++;
        } else {
          clearInterval(typeInterval);
          setTimeout(() => {
            eraseText();
          }, 2000);
        }
      }, 100);
    }
  }

  function eraseText() {
    if (textElement) {
      const currentText = textElement.textContent || "";
      let charIndex = currentText.length;
      
      const eraseInterval = setInterval(() => {
        if (charIndex > 0) {
          textElement.textContent = currentText.substring(0, charIndex - 1);
          charIndex--;
        } else {
          clearInterval(eraseInterval);
          currentIndex = (currentIndex + 1) % texts.length;
          setTimeout(() => {
            typeText();
          }, 500);
        }
      }, 50);
    }
  }

  typeText();
</script>
