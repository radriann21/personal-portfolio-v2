---
import { Image } from 'astro:assets';

interface Props {
  slug?: string;
  title?: string;
  description?: string;
  image?: string;
  tags?: string[];
  project?: {
    codeUrl?: string;
    liveUrl?: string;
  };
}

const {
  slug,
  title,
  description,
  image = "https://placehold.co/600x400/4F46E5/4F46E5",
  tags = [],
} = Astro.props;
---

<article class="w-full">
  <a
    href={`/projects/${slug}`}
    data-astro-prefetch
    class="w-full flex flex-col bg-white border-4 border-black shadow-[8px_8px_0px_0px_rgba(0,0,0,1)] hover:shadow-[12px_12px_0px_0px_rgba(0,0,0,1)] transition-all duration-200 hover:-translate-y-1 cursor-pointer"
    aria-label={`View ${title} project details`}
  >
    <div class="w-full h-[200px] border-b-4 border-black overflow-hidden">
      <Image
        src={image}
        height="200"
        width="600"
        alt={`${title} preview`}
        class="w-full h-full object-cover"
        loading="lazy"
      />
    </div>
    <div class="w-full p-4 flex flex-col gap-3">
      <h3 class="font-bold text-xl text-gray-800 -tracking-wider">{title}</h3>
      <p class="text-sm text-gray-500 leading-relaxed -tracking-tighter">
        {description}
      </p>
      <div
        class="flex flex-wrap gap-2 mt-2"
        role="list"
        aria-label="Technologies used"
      >
        {
          tags.map((tag) => (
            <span
              class="px-4 py-1.5 bg-black text-white text-xs font-semibold rounded-full border-2 border-black"
              role="listitem"
            >
              {tag}
            </span>
          ))
        }
      </div>
    </div>
  </a>
</article>
