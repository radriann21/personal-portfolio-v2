<section class="w-full h-[520px] py-24 px-16 border-b-4 border-border">
  <div class="grid grid-cols-3 gap-2">
    <div class="col-span-2">
      <span id="typing-text" class="text-lg text-accent -tracking-tight font-semibold inline-block min-h-[28px]"
        ></span
      >
      <h2 class="text-6xl font-bold">
        Creating high-performance, scalable web applications
      </h2>
      <p class="text-lg text-muted-foreground mt-2">
        2+ years building web applications with modern technologies, clean
        architecture and exceptional user experiences, powered by AI.
      </p>
      <button
        class="font-global font-medium uppercase -tracking-tight text-sm sm:text-lg px-3 py-1.5 sm:px-4 sm:py-2 bg-accent text-white border-[3px] border-black cursor-pointer shadow-[8px_8px_0px_0px_rgba(0,0,0,1)] transition-all duration-200 hover:-translate-y-1 hover:shadow-[12px_12px_0px_0px_rgba(0,0,0,1)] active:translate-x-0 active:translate-y-0 active:shadow-none mt-4"
      >
        Check my work
      </button>
    </div>
    <div class="col-span-1">
      <img src="/images/hero.png" alt="Hero" />
    </div>
  </div>
</section>

<script>
  const texts = [
    "Web Developer",
    "2+ Years of Experience",
    "Clean Architecture and smooth UX"
  ];
  
  let currentIndex = 0;
  const textElement = document.getElementById("typing-text");

  function typeText() {
    const currentText = texts[currentIndex];
    let charIndex = 0;
    
    if (textElement) {
      textElement.textContent = "";
      
      const typeInterval = setInterval(() => {
        if (charIndex < currentText.length) {
          textElement.textContent += currentText[charIndex];
          charIndex++;
        } else {
          clearInterval(typeInterval);
          setTimeout(() => {
            eraseText();
          }, 2000);
        }
      }, 100);
    }
  }

  function eraseText() {
    if (textElement) {
      const currentText = textElement.textContent || "";
      let charIndex = currentText.length;
      
      const eraseInterval = setInterval(() => {
        if (charIndex > 0) {
          textElement.textContent = currentText.substring(0, charIndex - 1);
          charIndex--;
        } else {
          clearInterval(eraseInterval);
          currentIndex = (currentIndex + 1) % texts.length;
          setTimeout(() => {
            typeText();
          }, 500);
        }
      }, 50);
    }
  }

  typeText();
</script>
