        <div
          class="about-card bg-white border-3 sm:border-4 border-black p-5 sm:p-6 md:p-8 shadow-[6px_6px_0px_0px_rgba(0,0,0,1)] sm:shadow-[8px_8px_0px_0px_rgba(0,0,0,1)] flex flex-col gap-3 sm:gap-4"
        >
          <p class="text-sm sm:text-base leading-relaxed font-mono">
