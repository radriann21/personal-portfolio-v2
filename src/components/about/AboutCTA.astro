<section class="w-full py-8 sm:py-10 md:py-12 px-4 sm:px-6 md:px-8 lg:px-16 bg-blue">
  <div class="container mx-auto max-w-7xl">
    <div class="cta-card w-full bg-pink border-3 sm:border-4 border-black p-6 sm:p-8 md:p-10 lg:p-12 shadow-[8px_8px_0px_0px_rgba(0,0,0,1)] sm:shadow-[10px_10px_0px_0px_rgba(0,0,0,1)] md:shadow-[12px_12px_0px_0px_rgba(0,0,0,1)] rounded-xl sm:rounded-2xl flex flex-col items-center justify-center gap-4 sm:gap-5 md:gap-6 text-center opacity-0">
      <h2 class="cta-title text-2xl sm:text-3xl md:text-4xl lg:text-5xl font-bold text-black -tracking-tight opacity-0">
        Let's Create Something Bold
      </h2>
      <p class="cta-text text-sm sm:text-base md:text-lg text-black/80 max-w-2xl leading-relaxed opacity-0 px-2">
        Interested in working together? I'd love to hear about your project and how we can collaborate.
      </p>
      <a
        href="/#contact"
        class="cta-button font-global font-medium uppercase -tracking-tight text-xs sm:text-sm md:text-base lg:text-lg px-6 py-3 sm:px-8 sm:py-4 bg-green text-black border-2 sm:border-[3px] border-black cursor-pointer shadow-[6px_6px_0px_0px_rgba(0,0,0,1)] sm:shadow-[8px_8px_0px_0px_rgba(0,0,0,1)] transition-all duration-200 hover:-translate-y-1 hover:shadow-[8px_8px_0px_0px_rgba(0,0,0,1)] md:hover:shadow-[12px_12px_0px_0px_rgba(0,0,0,1)] active:translate-x-0 active:translate-y-0 active:shadow-none opacity-0"
      >
        Get in Touch
      </a>
    </div>
  </div>
</section>

<script>
  import { animate, stagger } from 'animejs';

  document.addEventListener('DOMContentLoaded', () => {
    const card = document.querySelector('.cta-card');
    const title = document.querySelector('.cta-title');
    const text = document.querySelector('.cta-text');
    const button = document.querySelector('.cta-button');

    const observer = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          if (card) {
            animate(card, {
              translateY: [50, 0],
              opacity: [0, 1],
              duration: 1000,
              easing: 'out-expo'
            });
          }

          if (title && text && button) {
            animate([title, text, button], {
              translateY: [20, 0],
              opacity: [0, 1],
              duration: 800,
              delay: stagger(150, { start: 400 }),
              easing: 'out-expo'
            });
          }

          observer.disconnect();
        }
      });
    }, { threshold: 0.2 });

    if (card) {
      observer.observe(card);
    }
  });
</script>
